# Defaults match OpenVidu Local (https://openvidu.io/latest/docs/self-hosting/local.html).
# Copy to .env and edit only if your deployment differs.

# Level 1 — OpenVidu Meet REST API
MEET_URL=http://localhost:9080/meet
MEET_API_KEY=meet-api-key

# Levels 2 and 3 — OpenVidu access tokens
OPENVIDU_API_KEY=devkey
OPENVIDU_API_SECRET=secret
